ef get_keywords_tf_idf(text, top_n=5):
    # Paso 2: Tokenización en sentencias. "Cada sentencia = un documento" 
    sentences = sent_tokenize(text)
    
    # Limpieza aplicada a cada sentencia 
    clean_sentences = [clean_text_round(s) for s in sentences]
    clean_sentences = [s for s in clean_sentences if len(s) > 3] # Filtro básico
    
    if not clean_sentences: return []

    total_documents = len(clean_sentences) # N en la fórmula de IDF 
    
    # Configuración (Stemming y Stopwords) 
    stop_words = set(stopwords.words("spanish"))
    stop_words.update(['hotel', 'habitacion', 'alojamiento', 'si', 'mas', 'todo', 'muy', 'nos', 'solo', 'hacer'])
    stemmer = SnowballStemmer("spanish") # Usamos Snowball porque es español, Porter es para inglés.
    
    # ---------------------------------------------------------
    # Paso 3 y 4: Matriz de Frecuencia 
    # ---------------------------------------------------------
    frequency_matrix = {}
    stem_to_original = {} 

    for sent in clean_sentences:
        freq_table = {}
        words = word_tokenize(sent) # 
        for word in words:
            word_lower = word.lower()
            if word_lower in stop_words or not word_lower.isalpha():
                continue
            
            # Aplicar Stemming 
            root = stemmer.stem(word_lower)
            
            # Guardamos referencia de la palabra real para mostrarla bonita luego
            if root not in stem_to_original:
                stem_to_original[root] = word_lower
            
            # Contar frecuencia 
            if root in freq_table:
                freq_table[root] += 1
            else:
                freq_table[root] = 1
        frequency_matrix[sent] = freq_table

    # ---------------------------------------------------------
    # Paso 5: Matriz TF (Term Frequency) 
    # TF = apariciones / palabras únicas
    # ---------------------------------------------------------
    tf_matrix = {}
    for sent, f_table in frequency_matrix.items():
        tf_table = {}
        count_words = len(f_table) # 
        if count_words == 0: continue
        for word, count in f_table.items():
            tf_table[word] = count / count_words # 
        tf_matrix[sent] = tf_table

    # ---------------------------------------------------------
    # Paso 6: Matriz IDF (Inverse Document Frequency) 
    # IDF = log10(N / nt)
    # ---------------------------------------------------------
    # Primero contamos en cuántos docs aparece cada palabra 
    word_per_doc_table = {}
    for sent, f_table in frequency_matrix.items():
        for word in f_table.keys():
            word_per_doc_table[word] = word_per_doc_table.get(word, 0) + 1
            
    idf_matrix = {}
    for sent, f_table in frequency_matrix.items():
        idf_table = {}
        for word in f_table.keys():
            # Implementación de la fórmula 
            idf_table[word] = math.log10(total_documents / float(word_per_doc_table[word]))
        idf_matrix[sent] = idf_table

    # ---------------------------------------------------------
    # Paso 7: Matriz TF-IDF 
    # TF-IDF = TF * IDF
    # ---------------------------------------------------------
    final_word_scores = {}
    
    for sent, f_table in tf_matrix.items():
        if sent in idf_matrix:
            for word, tf_val in f_table.items():
                idf_val = idf_matrix[sent].get(word, 0)
                score = tf_val * idf_val 
                if word in final_word_scores:
                    final_word_scores[word] += score
                else:
                    final_word_scores[word] = score

    # Ordenar resultados
    sorted_stems = sorted(final_word_scores.items(), key=lambda x: x[1], reverse=True)
    top_keywords = [stem_to_original[stem] for stem, score in sorted_stems[:top_n]]
    
    return top_keywords





df = pd.read_csv('valoraciones_scrapping_bucle.csv')
df['positivo'] = df['positivo'].fillna('')
df['negativo'] = df['negativo'].fillna('')
grouped = df.groupby('hotel').agg({
    'positivo': lambda x: ' '.join(x),
    'negativo': lambda x: ' '.join(x)
}).reset_index()

# Generar reporte
print(f"{'HOTEL':<25} | {'PALABRAS CLAVE POSITIVAS':<40} | {'PALABRAS CLAVE NEGATIVAS':<40}")
print("-" * 110)

for index, row in grouped.iterrows():
    hotel = row['hotel']
    
    # Aplicar el algoritmo a cada columna
    keywords_pos = get_keywords_tf_idf(row['positivo'], top_n=5)
    keywords_neg = get_keywords_tf_idf(row['negativo'], top_n=5)
    
    print(f"{hotel:<25} | {', '.join(keywords_pos):<40} | {', '.join(keywords_neg):<40}")
